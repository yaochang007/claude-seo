#!/usr/bin/env bash
set -euo pipefail

# Stable entry point for bundled Python tools. The launcher uses only shell
# built-ins until a usable Python 3 interpreter has been identified.
#
# It lives in scripts/ rather than bin/ because hosted marketplaces reject any
# plugin that ships a top-level bin/ directory. Skills, agents, and hooks call
# it as "${SEO_SKILL_ROOT}/scripts/codex-seo"; runtime.py is a sibling.
launcher_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
runtime="${launcher_dir}/runtime.py"

if [[ ! -f "${runtime}" ]]; then
    echo "Codex SEO runtime is missing. Reinstall Codex SEO." >&2
    exit 2
fi

# An override is an executable path, not a shell command. Keeping it as one
# array element prevents command injection and supports paths containing spaces.
if [[ -n "${CODEX_SEO_PYTHON:-}" ]]; then
    if "${CODEX_SEO_PYTHON}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${CODEX_SEO_PYTHON}" "${runtime}" "$@"
    fi
    echo "CODEX_SEO_PYTHON is not a usable Python 3.10+ executable." >&2
    exit 2
fi

# Reuse the isolated interpreter after setup, even when the system Python is
# too old. Keep these locations aligned with runtime.py's _data_dir().
if [[ -n "${CODEX_SEO_DATA_DIR:-}" ]]; then
    managed_data_dir="${CODEX_SEO_DATA_DIR}"
    # Match Path.expanduser() for the common quoted ~/... override.
    if [[ "${managed_data_dir}" == "~/"* ]]; then
        managed_data_dir="${HOME}/${managed_data_dir#\~/}"
    fi
elif [[ "${OSTYPE:-}" == darwin* ]]; then
    managed_data_dir="${HOME}/Library/Application Support/codex-seo"
elif [[ "${OSTYPE:-}" == msys* || "${OSTYPE:-}" == cygwin* || "${OS:-}" == Windows_NT ]]; then
    managed_data_dir="${LOCALAPPDATA:-${HOME}/AppData/Local}/codex-seo"
else
    managed_data_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/codex-seo"
fi
for managed_python in "${managed_data_dir}/.venv/bin/python" "${managed_data_dir}/.venv/Scripts/python.exe"; do
    if [[ -x "${managed_python}" ]] && "${managed_python}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        exec "${managed_python}" "${runtime}" "$@"
    fi
done

if command -v py >/dev/null 2>&1 && py -3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    exec py -3 "${runtime}" "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    exec python3 "${runtime}" "$@"
fi
if command -v python >/dev/null 2>&1 && python -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    exec python "${runtime}" "$@"
fi

echo "Codex SEO requires Python 3.10 or newer. Tried CODEX_SEO_PYTHON, the managed runtime, py -3, python3, and python." >&2
exit 2
